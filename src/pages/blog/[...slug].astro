---
import { getCollection } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const deriveSlug = (id: string) => id.replace(/\.md$/, '').replace(/^\d{4}-\d{2}-\d{2}-/, '');
  return posts.map(entry => ({
    // Prefer an explicit `slug` field (lets Front Matter's preview match the
    // route); fall back to the filename with its date prefix stripped.
    params: { slug: entry.data.slug ?? deriveSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<PostLayout frontmatter={{ ...entry.data, date: entry.data.date ?? new Date('1970-01-01') }}>
  <Content />
</PostLayout>
