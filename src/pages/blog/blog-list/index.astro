---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/posts";

const posts = (await getPosts()).filter((post) => !post.hidden);
const years = [...new Set(posts.map((post) => post.year))];
---
<BaseLayout title="Blog" fullWidth>
  <h1>Writings</h1>
  <p class="subtitle">by Zeugnis</p>

  {posts.length > 0 ? (
    years.map((year) => (
      <>
        <h2 id={year}>{year}</h2>
        <ul>
          {posts
            .filter((post) => post.year === year)
            .map((post) => (
              <li>
                <p>
                  <a href={post.url}>{post.title}</a> —{" "}
                  <span style="font-style: italic">{post.monthDayLabel}</span>
                </p>
              </li>
            ))}
        </ul>
      </>
    ))
  ) : (
    <p>Watch this space for the first post!</p>
  )}

  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: left;">
      <a href="/featured-albums-archive/">→ Featured albums archive</a><br />
      <a href="/books-archive/">→ Books archive</a>
    </p>
  </section>
</BaseLayout>
