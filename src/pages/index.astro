---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Notice from "@/components/Notice.astro";
import { formatMediaTitle, getMediaItems } from "@/lib/media";
import { getPosts, slugify } from "@/lib/posts";

const recentPosts = (await getPosts()).filter((post) => !post.hidden).slice(0, 5);
const mediaItems = (await getMediaItems()).slice(0, 2);

const featuredAlbums = [
  {
    title: "Holy Diamond Blue - Kamikaze Prom Night",
    url: "/blog/holy-diamond-blue/",
    photo: "/assets/img/featured_albums/holy-diamond-blue.webp",
    alt: "Holy Diamond Blue",
    review: "travel through your imaginary paradise",
  },
  {
    title: "Magic, Alive! - McKinley Dixon",
    url: "/blog/magic-alive/",
    photo: "/assets/img/featured_albums/magic-alive.webp",
    alt: "Magic, Alive!",
    review: "how much more alive can music be",
  },
  {
    title: "The Cure - Songs of a Lost World",
    url: "/blog/songs-of-a-lost-world/",
    photo: "/assets/img/featured_albums/songs-of-a-lost-world.webp",
    alt: "Songs of a Lost World",
    review: "emotional and powerful yet unique",
  },
];

---
<BaseLayout
  title="Random Access Memories"
  headTitle="Welcome to RAM"
  subtitle="Archiving and revisiting thoughts"
  hero
>
  <Notice title="Notice">
    This blog is currently being migrated to a new system. Domain changes and occasional malfunctions may occur in the meantime.
  </Notice>

  <div class="index-title"><span class="ornament">1</span> Recent Posts</div>
  <div class="recent-posts">
    {recentPosts.map((post) => (
      <div class="recent-post">
        <h4>
          <a href={post.url}>{post.title}</a>
        </h4>
        <div class="post-meta">
          {post.dateLabel}
          {" "}
          <strong><span class="tag-ornament">j</span>Tags</strong>:
          {" "}
          {post.tags.map((tag, index) => (
            <>
              <a href={`/tags/#${slugify(tag)}`} class="tag">{tag}</a>{index < post.tags.length - 1 ? ", " : ""}
            </>
          ))}
        </div>
        <p class="post-excerpt">{post.excerpt}</p>
      </div>
    ))}
  </div>

  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: right;"><a href="/blog/blog-list/">→ Blog list</a></p>
  </section>

  <hr />

  <div class="index-title"><span class="ornament">b</span> Featured Albums</div>
  <div class="album-flex inside-text-width">
    {featuredAlbums.map((album) => (
      <div class="album">
        <a href={album.url}>
          <img src={album.photo} alt={album.alt} />
        </a>
        <div class="album-info">
          <h4>{album.title}</h4>
          <p><em>{album.review}</em></p>
        </div>
      </div>
    ))}
  </div>
  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: right;"><a href="/featured-albums-archive/">→ Featured albums archive</a></p>
  </section>

  <hr />

  <div class="index-title"><span class="ornament">a</span> Media Archive</div>
  <div class="album-flex inside-text-width">
    {mediaItems.map((item) => (
      <div class="album">
        <img src={item.photo} alt={formatMediaTitle(item)} />
        <div class="album-info">
          <h4>{formatMediaTitle(item)} – {item.creator}</h4>
        </div>
      </div>
    ))}
  </div>
  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: right;"><a href="/media-archive/">→ Media Archive</a></p>
  </section>
</BaseLayout>
