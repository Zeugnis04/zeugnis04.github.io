---
import BaseLayout from "@/layouts/BaseLayout.astro";

const recentPosts = [
  {
    title: "이것저것",
    url: "/blog/spring/",
    date: "2026-04-13",
    tags: ["casual"],
    excerpt: "간만에 한국어로 글을 적는다. 본의 아니게 블로그에 길이가 있고 진지한 글만 쓰게 되는 것 같아 오늘은 의식적으로 짧게 이것저것 적어보려고 한다.",
  },
  {
    title: "Using the Interlinear Gloss Tag",
    url: "/blog/interlinear-gloss-tag/",
    date: "2026-04-12",
    tags: ["linguistics", "meta"],
    excerpt: "This site has a custom Liquid tag for writing interlinear glosses following the Leipzig Glossing Rules. This post documents how to use it.",
  },
  {
    title: "おめでとうの唄 Lyrics and Translation",
    url: "/blog/omedetou-no-uta/",
    date: "2026-02-02",
    tags: ["aoba-ichiko", "japanese", "lyrics", "music"],
    excerpt: "From 青葉市子, マホロボシヤ (2016). Happy birthday to our dearest ones.",
  },
  {
    title: "Trip to Hawaiʻi and Food",
    url: "/blog/trip-to-hawaii-polynesian-food/",
    date: "2026-01-23",
    tags: ["culture", "photo", "hawai'i", "travel", "food-culture"],
    excerpt: "From a trip to Hawaiʻi in January 2026, with notes on Hawaiian, Micronesian, and Samoan food.",
  },
  {
    title: "Beginning coffee",
    url: "/blog/beginning-coffee/",
    date: "2025-12-29",
    tags: ["coffee", "food-culture"],
    excerpt: "I wanted to try brewing my own coffee for a long time, and finally here they are.",
  },
];

const featuredAlbums = [
  {
    title: "Magic, Alive! - McKinley Dixon",
    url: "/blog/album-review/magic-alive/",
    photo: "/assets/img/featured_albums/magic-alive.webp",
    alt: "Magic, Alive!",
    review: "how much more alive can music be",
  },
  {
    title: "The Cure - Songs of a Lost World",
    url: "/blog/album-review/songs-of-a-lost-world/",
    photo: "/assets/img/featured_albums/songs-of-a-lost-world.webp",
    alt: "Songs of a Lost World",
    review: "emotional and powerful yet unique",
  },
];

const mediaItems = [
  {
    title: "데이미언 허스트 展",
    creator: "국립현대미술관 MMCA",
    photo: "/assets/img/media-archive/damien-hurst.png",
  },
  {
    title: "Wisdom Through Music",
    creator: "Pharoah Sanders",
    photo: "https://i.scdn.co/image/ab67616d000082c1d24eb39e1db31157ac27236b",
  },
];
---
<BaseLayout
  title="Random Access Memories"
  headTitle="Welcome to RAM"
  subtitle="Archiving and revisiting thoughts"
>
  <div class="index-title"><span class="ornament">1</span> Recent Posts</div>
  <div class="recent-posts">
    {recentPosts.map((post) => (
      <div class="recent-post">
        <h4>
          <a href={post.url}>{post.title}</a>
        </h4>
        <div class="post-meta">
          {post.date}
          {" "}
          <strong><span class="tag-ornament">j</span>Tags</strong>:
          {" "}
          {post.tags.map((tag, index) => (
            <>
              <a href={`/tags/#${tag}`} class="tag">{tag}</a>{index < post.tags.length - 1 ? ", " : ""}
            </>
          ))}
        </div>
        <p class="post-excerpt">{post.excerpt}</p>
      </div>
    ))}
  </div>

  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: right;"><a href="/blog/blog-list/">→ Blog list</a></p>
  </section>

  <hr />

  <div class="index-title"><span class="ornament">b</span> Featured Albums</div>
  <div class="album-flex inside-text-width">
    {featuredAlbums.map((album) => (
      <div class="album">
        <a href={album.url}>
          <img src={album.photo} alt={album.alt} />
        </a>
        <div class="album-info">
          <h4>{album.title}</h4>
          <p><em>{album.review}</em></p>
        </div>
      </div>
    ))}
  </div>
  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: right;"><a href="/featured-albums-archive/">→ Featured albums archive</a></p>
  </section>

  <hr />

  <div class="index-title"><span class="ornament">a</span> Media Archive</div>
  <div class="album-flex inside-text-width">
    {mediaItems.map((item) => (
      <div class="album">
        <img src={item.photo} alt={item.title} />
        <div class="album-info">
          <h4>{item.title} – {item.creator}</h4>
        </div>
      </div>
    ))}
  </div>
  <section>
    <div style="clear: both"></div>
    <p class="backarrow" style="text-align: right;"><a href="/media-archive/">→ Media Archive</a></p>
  </section>
</BaseLayout>
