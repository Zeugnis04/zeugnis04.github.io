  ["通", "東 uwng", "", "東 juwng", "", "1開"],
  ["", "冬 owng", "", "鍾 jowng", "", "2開合"],
  ["江", "", "江 aewng", "", "", "3開合"],
  ["止", "", "", "支 je", "支 jie", "4開合"],
  ["", "", "", "支 jwe", "支 jwie", "5合"],
  ["", "", "", "脂 ij", "脂 jij", "6開"],
  ["", "", "", "脂 wij", "脂 jwij", "7合"],
  ["", "", "", "之 i", "", "8開"],
  ["", "", "", "微 j+j", "", "9開"],
  ["", "", "", "微 jw+j", "", "10合"],
  ["遇", "", "", "魚 jo", "", "11開"],
  ["", "模 u", "", "虞 ju", "", "12開合"],
  ["蟹", "咍 oj", "皆 eaj", "祭 jej", "齊 ej", "13開"],
  ["", "", "夬 aej", "", "", ""],
  ["", "灰 woj", "皆 weaj", "祭 jwej", "齊 wej", "14合"],
  ["", "", "夬 waej", "", "", ""],
  ["", "泰 aj", "佳 ea", "", "祭 jiej", "15開"],
  ["", "泰 waj", "佳 wea", "", "祭 jwej", "16合"],
  ["", "", "", "廢 joj", "", "9開"],
  ["", "", "", "廢 jwoj", "", "10合"],
  ["臻", "痕 on", "", "臻 in", "真 jin", "17開"],
  ["", "魂 won", "", "真 win", "諄 jwin", "18合"],
  ["", "", "", "欣 j+n", "", "19開"],
  ["", "", "", "文 jun", "", "20合"],
  ["山", "", "山 ean", "元 jon", "仙 jien", "21開"],
  ["", "", "山 wean", "元 jwon", "仙 jwien", "22合"],
  ["", "寒 an", "刪 aen", "仙 jen", "先 en", "23開"],
  ["", "桓 wan", "刪 waen", "仙 jwen", "先 wen", "24合"],
  ["效", "豪 aw", "肴 aew", "宵 jew", "蕭 ew", "25開"],
  ["", "", "", "", "宵 jiew", "26合"],
  ["果", "歌 a", "", "", "", "27合"],
  ["", "戈 wa", "", "戈 jwa", "戈開三 ja", "28合"],
  ["假", "", "麻 ae", "麻 jae", "", "29開"],
  ["", "", "麻 wae", "", "", "30合"],
  ["宕", "唐 ang", "", "陽 jang", "", "31開"],
  ["", "唐 wang", "", "陽 jwang", "", "32合"],
  ["梗", "", "庚 aeng", "庚 jaeng", "清 jeng", "33開"],
  ["", "", "庚 waeng", "庚 jwaeng", "清 jweng", "34合"],
  ["", "", "耕 eang", "", "青 eng", "35開"],
  ["", "", "耕 weang", "", "青 weng", "36合"],
