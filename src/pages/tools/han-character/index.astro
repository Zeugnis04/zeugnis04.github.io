---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Han Character Readings"
  description="A private working page for comparing Sino-Xenic and Middle Chinese readings."
  noindex
>
  <h1>Han Character Readings</h1>
  <p class="subtitle">Sinological reading lookup</p>
  <p>
    Look up modern Chinese dialect, Japanese, Korean, Middle Chinese, and Old Chinese readings from
    <a href="https://en.wiktionary.org/" rel="noreferrer">English Wiktionary</a>.
  </p>

  <form class="lookup-form" id="lookup-form">
    <label for="character-input">Chinese character</label>
    <div class="input-row">
      <input
        id="character-input"
        name="character"
        type="text"
        inputmode="text"
        maxlength="2"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="東"
        aria-describedby="input-help"
        required
      />
      <button type="submit">Look up</button>
    </div>
    <p id="input-help" class="input-help no-ornament">Enter one Han character, traditional or simplified.</p>
  </form>

  <p class="status no-ornament" id="status" role="status" aria-live="polite"></p>

  <section class="results" id="results" hidden>
    <div class="results-main">
    <div class="character-heading">
      <h2 id="result-character" lang="zh"></h2>
      <a id="wiktionary-link" href="https://en.wiktionary.org/" target="_blank" rel="noreferrer">
        Open Wiktionary
      </a>
    </div>

    <div data-section-body="modern">
      <h2>Modern readings</h2>
      <div class="result-table">
        <table class="fullwidth readings-table modern-table">
          <colgroup>
            <col class="modern-language-column" />
            <col class="modern-system-column" />
            <col />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">Language</th>
              <th scope="col">System</th>
              <th scope="col">Reading</th>
            </tr>
          </thead>
          <tbody id="modern-readings"></tbody>
        </table>
      </div>
    </div>

    <div data-section-body="middle-chinese">
      <h2>Middle Chinese <i lang="zh">中古漢語</i></h2>
      <p>
        Baxter transcription with fanqie and traditional rime-table categories.
        The 攝 is read from Wiktionary’s final number (e.g. 欣 (57)); the 轉 is inferred from the listed final.
        <a href="/tools/han-character/rime-reference/">Read the 攝 and rime reference</a>.
      </p>
      <div class="result-table">
        <table class="fullwidth readings-table middle-chinese-table">
          <colgroup>
            <col class="mc-label-column" />
            <col class="mc-value-column" />
          </colgroup>
          <tbody id="middle-chinese-readings"></tbody>
        </table>
      </div>
    </div>

    <div data-section-body="old-chinese">
      <h2>Old Chinese <i lang="zh">上古漢語</i></h2>
      <p>Reconstructions read from Wiktionary’s Zhengzhang (2003) and Baxter–Sagart (2014) tables.</p>
      <div class="result-table">
        <table class="fullwidth readings-table middle-chinese-table">
          <colgroup>
            <col class="mc-label-column" />
            <col class="mc-value-column" />
          </colgroup>
          <tbody id="old-chinese-readings"></tbody>
        </table>
      </div>
    </div>

    <p class="source-note no-ornament">
      Data is parsed live from Wiktionary and may be incomplete when an entry uses an unusual template.
      Display choices are saved in this browser.
    </p>
    </div>

    <aside class="display-panel" aria-label="Display options">
      <div class="display-panel-inner">
        <h2>Display</h2>
        <div id="display-controls"></div>
      </div>
    </aside>
  </section>
</BaseLayout>

<script>
  type ReadingMap = Record<string, string>;

  type ModernRow = {
    system: string;
    systemLang?: string;
    value: string;
    lang?: string;
  };

  type ModernGroup = {
    key: string;
    rows: ModernRow[];
  };

  type MiddleChineseReading = {
    baxter: string;
    fanqie: string;
    initial: string;
    final: string;
    tone: string;
    openness: string;
    division: string;
    she: string;
    finalClass: string;
    zhuan: string;
  };

  type OldChinese = {
    zhengzhang: string;
    baxterSagart: string;
  };

  type CharacterData = {
    character: string;
    sourceCharacter: string;
    modern: ModernGroup[];
    middleChinese: MiddleChineseReading[];
    oldChinese: OldChinese;
  };

  type DisplayPrefs = {
    hiddenSections: string[];
    hiddenEntries: string[];
    shownEntries: string[];
    groupOrder: string[];
    mcFieldOrder: string[];
  };

  const API_URL = "https://en.wiktionary.org/w/api.php";
  const EMPTY_VALUE = "Not listed";
  const PREFS_KEY = "han-character-display";

  const SECTIONS: Array<[string, string]> = [
    ["modern", "Modern readings"],
    ["middle-chinese", "Middle Chinese"],
    ["old-chinese", "Old Chinese"],
  ];

  const MC_FIELD_LABELS = [
    "Baxter",
    "Fanqie 反切",
    "攝",
    "轉",
    "韻類",
    "Initial 聲",
    "Final 韻",
    "Tone 調",
    "Openness 呼",
    "Division 等",
  ];

  const OC_SYSTEMS: Array<["zhengzhang" | "baxterSagart", string]> = [
    ["zhengzhang", "Zhengzhang"],
    ["baxterSagart", "Baxter–Sagart"],
  ];

  const GROUP_LABELS: Record<string, { native: string; lang: string }> = {
    Mandarin: { native: "官話", lang: "zh" },
    Cantonese: { native: "粵語", lang: "zh" },
    Gan: { native: "贛語", lang: "zh" },
    Hakka: { native: "客家話", lang: "zh" },
    Jin: { native: "晉語", lang: "zh" },
    "Northern Min": { native: "閩北語", lang: "zh" },
    "Eastern Min": { native: "閩東語", lang: "zh" },
    "Southern Min": { native: "閩南語", lang: "zh" },
    "Puxian Min": { native: "莆仙語", lang: "zh" },
    Wu: { native: "吳語", lang: "zh" },
    Xiang: { native: "湘語", lang: "zh" },
    "Southern Pinghua": { native: "南部平話", lang: "zh" },
    Japanese: { native: "日本語", lang: "ja" },
    Korean: { native: "한국 한자음", lang: "ko" },
  };

  const SHE_GROUPS: Record<string, string> = {
    通: "東冬鍾鐘",
    江: "江",
    止: "支脂之微",
    遇: "魚虞模",
    蟹: "齊佳皆灰咍祭泰夬廢",
    臻: "眞真諄臻文欣魂痕",
    山: "元寒桓刪山先仙",
    效: "蕭宵肴豪",
    果: "歌戈",
    假: "麻",
    宕: "陽唐",
    梗: "庚耕淸清靑青",
    曾: "蒸登",
    流: "尤侯幽",
    深: "侵",
    咸: "覃談鹽添咸銜嚴凡",
  };

  // Wiktionary numbers its Middle Chinese finals 1–160 (e.g. 欣 (57));
  // each range of numbers belongs to one 攝.
  const SHE_BY_FINAL_NUMBER: Array<{ she: string; from: number; to: number }> = [
    { she: "通", from: 1, to: 8 },
    { she: "江", from: 9, to: 10 },
    { she: "止", from: 11, to: 21 },
    { she: "遇", from: 22, to: 24 },
    { she: "蟹", from: 25, to: 42 },
    { she: "臻", from: 43, to: 60 },
    { she: "山", from: 61, to: 88 },
    { she: "效", from: 89, to: 93 },
    { she: "果", from: 94, to: 97 },
    { she: "假", from: 98, to: 100 },
    { she: "宕", from: 101, to: 108 },
    { she: "梗", from: 109, to: 132 },
    { she: "曾", from: 133, to: 135 },
    { she: "流", from: 136, to: 138 },
    { she: "深", from: 139, to: 142 },
    { she: "咸", from: 143, to: 160 },
  ];

  const FINAL_VARIANTS: Record<string, string> = {
    鍾: "鐘",
    眞: "真",
    淸: "清",
    靑: "青",
  };

  const DIVISION_LABELS: Record<string, string> = {
    I: "一",
    II: "二",
    III: "三",
    IV: "四",
  };

  const RIME_TURN_ROWS = [
    { turn: "1開", I: ["東"], II: [], III: ["東"], IV: [] },
    { turn: "2開合", I: ["冬"], II: [], III: ["鍾", "鐘"], IV: [] },
    { turn: "3開合", I: [], II: ["江"], III: [], IV: [] },
    { turn: "4開合", I: [], II: [], III: ["支"], IV: ["支"] },
    { turn: "5合", I: [], II: [], III: ["支"], IV: ["支"] },
    { turn: "6開", I: [], II: [], III: ["脂"], IV: ["脂"] },
    { turn: "7合", I: [], II: [], III: ["脂"], IV: ["脂"] },
    { turn: "8開", I: [], II: [], III: ["之"], IV: [] },
    { turn: "9開", I: [], II: [], III: ["微", "廢"], IV: [] },
    { turn: "10合", I: [], II: [], III: ["微", "廢"], IV: [] },
    { turn: "11開", I: [], II: [], III: ["魚"], IV: [] },
    { turn: "12開合", I: ["模"], II: [], III: ["虞"], IV: [] },
    { turn: "13開", I: ["咍"], II: ["皆", "夬"], III: ["祭"], IV: ["齊"] },
    { turn: "14合", I: ["灰"], II: ["皆", "夬"], III: ["祭"], IV: ["齊"] },
    { turn: "15開", I: ["泰"], II: ["佳"], III: [], IV: ["祭"] },
    { turn: "16合", I: ["泰"], II: ["佳"], III: [], IV: ["祭"] },
    { turn: "17開", I: ["痕"], II: [], III: ["臻"], IV: ["眞", "真"] },
    { turn: "18合", I: ["魂"], II: [], III: ["眞", "真"], IV: ["諄"] },
    { turn: "19開", I: [], II: [], III: ["欣"], IV: [] },
    { turn: "20合", I: [], II: [], III: ["文"], IV: [] },
    { turn: "21開", I: [], II: ["山"], III: ["元"], IV: ["仙"] },
    { turn: "22合", I: [], II: ["山"], III: ["元"], IV: ["仙"] },
    { turn: "23開", I: ["寒"], II: ["刪"], III: ["仙"], IV: ["先"] },
    { turn: "24合", I: ["桓"], II: ["刪"], III: ["仙"], IV: ["先"] },
    { turn: "25開", I: ["豪"], II: ["肴"], III: ["宵"], IV: ["蕭"] },
    { turn: "26合", I: [], II: [], III: [], IV: ["宵"] },
    { turn: "27合", I: ["歌"], II: [], III: [], IV: [] },
    { turn: "28合", I: ["戈"], II: [], III: ["戈"], IV: ["戈"] },
    { turn: "29開", I: [], II: ["麻"], III: ["麻"], IV: [] },
    { turn: "30合", I: [], II: ["麻"], III: [], IV: [] },
    { turn: "31開", I: ["唐"], II: [], III: ["陽"], IV: [] },
    { turn: "32合", I: ["唐"], II: [], III: ["陽"], IV: [] },
    { turn: "33開", I: [], II: ["庚"], III: ["庚"], IV: ["淸", "清"] },
    { turn: "34合", I: [], II: ["庚"], III: ["庚"], IV: ["淸", "清"] },
    { turn: "35開", I: [], II: ["耕"], III: [], IV: ["靑", "青"] },
    { turn: "36合", I: [], II: ["耕"], III: [], IV: ["靑", "青"] },
    { turn: "37開", I: ["侯"], II: [], III: ["尤"], IV: ["幽"] },
    { turn: "38合", I: [], II: [], III: ["侵"], IV: ["侵"] },
    { turn: "39合", I: ["覃"], II: ["咸"], III: ["鹽"], IV: ["添"] },
    { turn: "40開", I: ["談"], II: ["銜"], III: ["嚴"], IV: ["鹽"] },
    { turn: "41合", I: [], II: [], III: ["凡"], IV: [] },
    { turn: "42開", I: ["登"], II: [], III: ["蒸"], IV: [] },
    { turn: "43合", I: ["登"], II: [], III: ["職"], IV: [] },
  ] as const;

  const form = document.querySelector<HTMLFormElement>("#lookup-form");
  const input = document.querySelector<HTMLInputElement>("#character-input");
  const status = document.querySelector<HTMLElement>("#status");
  const results = document.querySelector<HTMLElement>("#results");
  const modernContainer = document.querySelector<HTMLElement>("#modern-readings");
  const middleChineseContainer = document.querySelector<HTMLElement>("#middle-chinese-readings");
  const oldChineseContainer = document.querySelector<HTMLElement>("#old-chinese-readings");
  const panelContainer = document.querySelector<HTMLElement>("#display-controls");

  let lastData: CharacterData | null = null;
  const openPanelGroups = new Set<string>();

  function loadPrefs(): DisplayPrefs {
    const fallback: DisplayPrefs = { hiddenSections: [], hiddenEntries: [], shownEntries: [], groupOrder: [], mcFieldOrder: [] };
    try {
      const raw = localStorage.getItem(PREFS_KEY);
      if (!raw) return fallback;
      const parsed = JSON.parse(raw) as Partial<DisplayPrefs>;
      return {
        hiddenSections: Array.isArray(parsed.hiddenSections) ? parsed.hiddenSections : [],
        hiddenEntries: Array.isArray(parsed.hiddenEntries) ? parsed.hiddenEntries : [],
        shownEntries: Array.isArray(parsed.shownEntries) ? parsed.shownEntries : [],
        groupOrder: Array.isArray(parsed.groupOrder) ? parsed.groupOrder : [],
        mcFieldOrder: Array.isArray(parsed.mcFieldOrder) ? parsed.mcFieldOrder : [],
      };
    } catch {
      return fallback;
    }
  }

  const prefs = loadPrefs();

  function savePrefs() {
    try {
      localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
    } catch {
      // Private browsing or full storage: preferences simply do not persist.
    }
  }

  // Languages shown by default; other dialect groups start toggled off, but
  // their main system is still pre-selected so enabling the group shows the
  // standard reading right away.
  const DEFAULT_GROUPS = new Set(["Mandarin", "Cantonese", "Southern Min", "Japanese", "Korean"]);

  // Entries the user has not touched fall back to a per-entry default:
  // for dialect rows only the group's first (main) system is on by default.
  function entryVisible(key: string, defaultVisible: boolean): boolean {
    if (prefs.shownEntries.includes(key)) return true;
    if (prefs.hiddenEntries.includes(key)) return false;
    return defaultVisible;
  }

  function defaultRowVisible(group: ModernGroup, system: string): boolean {
    if (group.key === "Japanese" || group.key === "Korean") return true;
    return group.rows[0]?.system === system;
  }

  function setEntryVisible(key: string, visible: boolean) {
    prefs.shownEntries = prefs.shownEntries.filter((entry) => entry !== key);
    prefs.hiddenEntries = prefs.hiddenEntries.filter((entry) => entry !== key);
    (visible ? prefs.shownEntries : prefs.hiddenEntries).push(key);
    savePrefs();
    rerender();
  }

  function orderKeys(natural: string[], saved: string[]): string[] {
    const rank = (key: string) => {
      const at = saved.indexOf(key);
      return at === -1 ? saved.length + natural.indexOf(key) : at;
    };
    return [...natural].sort((a, b) => rank(a) - rank(b));
  }

  function applySectionVisibility() {
    for (const body of document.querySelectorAll<HTMLElement>("[data-section-body]")) {
      body.hidden = prefs.hiddenSections.includes(body.dataset.sectionBody ?? "");
    }
  }

  applySectionVisibility();

  function rerender() {
    if (!lastData) return;
    const active = document.activeElement as HTMLElement | null;
    const focusId = active?.dataset?.controlId;
    render(lastData);
    if (focusId) {
      document.querySelector<HTMLElement>(`[data-control-id="${CSS.escape(focusId)}"]`)?.focus();
    }
  }

  function text(selector: string): HTMLElement {
    const element = document.querySelector<HTMLElement>(selector);
    if (!element) throw new Error(`Missing page element: ${selector}`);
    return element;
  }

  function normalize(value: string | null | undefined): string {
    return value?.replace(/\s+/g, " ").trim() ?? "";
  }

  // Table row labels may contain <br> (e.g. "Old<br>Chinese"), which leaves no
  // whitespace in textContent, so labels are compared with spacing removed.
  function compactLabel(value: string): string {
    return normalize(value).replace(/\s+/g, "").toLowerCase();
  }

  function singleHanCharacter(value: string): string | null {
    const characters = Array.from(value.trim()).filter((character) => !/[\uFE00-\uFE0F\u{E0100}-\u{E01EF}]/u.test(character));
    if (characters.length !== 1 || !/\p{Script=Han}/u.test(characters[0])) return null;
    return characters[0];
  }

  function extractTemplate(wikitext: string, templateName: string): string[] {
    const templates: string[] = [];
    const needle = `{{${templateName}`;
    let searchFrom = 0;

    while (searchFrom < wikitext.length) {
      const start = wikitext.indexOf(needle, searchFrom);
      if (start === -1) break;
      const boundary = wikitext[start + needle.length];
      if (boundary && boundary !== "|" && boundary !== "}" && !/\s/.test(boundary)) {
        searchFrom = start + needle.length;
        continue;
      }

      let depth = 0;
      let end = start;
      for (let index = start; index < wikitext.length - 1; index += 1) {
        const pair = wikitext.slice(index, index + 2);
        if (pair === "{{") {
          depth += 1;
          index += 1;
        } else if (pair === "}}") {
          depth -= 1;
          index += 1;
          if (depth === 0) {
            end = index + 1;
            break;
          }
        }
      }

      if (end > start) templates.push(wikitext.slice(start + 2, end - 2));
      searchFrom = Math.max(end, start + needle.length);
    }

    return templates;
  }

  function splitTemplate(template: string): string[] {
    const parts: string[] = [];
    let current = "";
    let curlyDepth = 0;
    let squareDepth = 0;

    for (let index = 0; index < template.length; index += 1) {
      const pair = template.slice(index, index + 2);
      if (pair === "{{") {
        curlyDepth += 1;
        current += pair;
        index += 1;
      } else if (pair === "}}" && curlyDepth > 0) {
        curlyDepth -= 1;
        current += pair;
        index += 1;
      } else if (pair === "[[") {
        squareDepth += 1;
        current += pair;
        index += 1;
      } else if (pair === "]]" && squareDepth > 0) {
        squareDepth -= 1;
        current += pair;
        index += 1;
      } else if (template[index] === "|" && curlyDepth === 0 && squareDepth === 0) {
        parts.push(current.trim());
        current = "";
      } else {
        current += template[index];
      }
    }

    parts.push(current.trim());
    return parts;
  }

  function templateArguments(template: string): { named: ReadingMap; positional: string[] } {
    const parts = splitTemplate(template);
    const named: ReadingMap = {};
    const positional: string[] = [];

    for (const part of parts.slice(1)) {
      const equalsAt = part.indexOf("=");
      if (equalsAt > 0) {
        named[part.slice(0, equalsAt).trim()] = part.slice(equalsAt + 1).trim();
      } else {
        positional.push(part.trim());
      }
    }

    return { named, positional };
  }

  function cleanWikiValue(value: string): string {
    return normalize(
      value
        .replace(/<!--[\s\S]*?-->/g, "")
        .replace(/<[^>]+>/g, "")
        .replace(/\{\{[^{}]*\}\}/g, "")
        .replace(/\[\[(?:[^\]|]*\|)?([^\]]+)\]\]/g, "$1")
        .replace(/<[^>]+/g, "")
        .replace(/-</g, "")
        .replace(/;/g, ", "),
    );
  }

  function unique(values: string[]): string {
    return [...new Set(values.map(cleanWikiValue).filter(Boolean))].join(", ");
  }

  function parseWikitext(wikitext: string) {
    const japaneseTemplates = extractTemplate(wikitext, "ja-readings");
    const onKeys = ["goon", "kanon", "toon", "soon", "kanyoon", "on"];
    const japaneseOn: string[] = [];
    const japaneseKun: string[] = [];

    for (const template of japaneseTemplates) {
      const { named } = templateArguments(template);
      for (const key of onKeys) {
        if (named[key]) japaneseOn.push(...named[key].split(","));
      }
      if (named.kun) japaneseKun.push(...named.kun.split(","));
    }

    const koHanja = extractTemplate(wikitext, "ko-hanja")[0];
    const koPron = extractTemplate(wikitext, "ko-hanja-pron")[0];
    let koreanReading = "";
    let koreanEumhun = "";

    if (koHanja) {
      const { positional } = templateArguments(koHanja);
      koreanEumhun = unique(positional.slice(0, 2));
      koreanReading = cleanWikiValue(positional[1] || positional[0] || "");
    }
    if (!koreanReading && koPron) {
      koreanReading = cleanWikiValue(templateArguments(koPron).positional[0] || "");
    }

    const seeTemplate = extractTemplate(wikitext, "zh-see")[0];
    const relatedCharacter = seeTemplate
      ? cleanWikiValue(templateArguments(seeTemplate).positional[0]?.split("|")[0] || "")
      : "";

    return {
      japaneseOn: unique(japaneseOn),
      japaneseKun: unique(japaneseKun),
      koreanReading,
      koreanEumhun,
      relatedCharacter: singleHanCharacter(relatedCharacter),
    };
  }

  function sectionContainer(documentNode: Document, headingId: string): HTMLElement | null {
    const heading = documentNode.getElementById(headingId);
    const wrapper = heading?.closest(".mw-heading");
    if (!heading || !wrapper) return null;

    const level = Number(heading.tagName.slice(1));
    const container = document.createElement("div");
    let sibling = wrapper.nextElementSibling;

    while (sibling) {
      const nextHeading = sibling.matches(".mw-heading")
        ? sibling.querySelector<HTMLElement>("h2, h3, h4, h5, h6")
        : null;
      if (nextHeading && Number(nextHeading.tagName.slice(1)) <= level) break;
      container.append(sibling.cloneNode(true));
      sibling = sibling.nextElementSibling;
    }

    return container;
  }

  function rowValues(table: HTMLTableElement, label: string): string[] {
    const wanted = compactLabel(label);
    for (const row of table.rows) {
      const cells = Array.from(row.cells);
      if (!cells.length) continue;
      const headCell = row.querySelector("th") ?? cells[0];
      if (!compactLabel(headCell.textContent ?? "").startsWith(wanted)) continue;
      return cells
        .filter((cell) => cell !== headCell && cell.tagName === "TD")
        .map((cell) => normalize(cell.textContent));
    }
    return [];
  }

  function rowValue(table: HTMLTableElement, label: string): string {
    return rowValues(table, label)[0] ?? "";
  }

  function sheForFinal(finalName: string): string {
    const numberMatch = finalName.match(/\((\d+)\)/);
    if (numberMatch) {
      const finalNumber = Number(numberMatch[1]);
      const range = SHE_BY_FINAL_NUMBER.find((entry) => finalNumber >= entry.from && finalNumber <= entry.to);
      if (range) return `${range.she}攝`;
    }

    const normalizedFinal = cleanFinalName(finalName);
    const match = Object.entries(SHE_GROUPS).find(([, finals]) => finals.includes(normalizedFinal));
    return match ? `${match[0]}攝` : "";
  }

  function cleanFinalName(finalName: string): string {
    const normalized = finalName.replace(/\s*\(\d+\)\s*$/, "").trim();
    return FINAL_VARIANTS[normalized] ?? normalized;
  }

  function divisionClass(value: string): string {
    const normalized = value.toUpperCase().replace(/[^IV]/g, "");
    return DIVISION_LABELS[normalized] ?? "";
  }

  function divisionKey(value: string): "I" | "II" | "III" | "IV" | "" {
    const normalized = value.toUpperCase().replace(/[^IV]/g, "");
    if (normalized === "I" || normalized === "II" || normalized === "III" || normalized === "IV") return normalized;
    return "";
  }

  function opennessClass(value: string): string {
    const normalized = value.toLowerCase();
    if (normalized.startsWith("closed") || normalized.includes("合")) return "合";
    return "";
  }

  function finalClass(finalName: string, division: string, openness: string): string {
    const final = cleanFinalName(finalName);
    if (!final) return "";
    const divisionLabel = divisionClass(division);
    const opennessLabel = opennessClass(openness);
    return `${final}${divisionLabel}${opennessLabel}`;
  }

  function zhuanForReading(finalName: string, division: string, openness: string): string {
    const final = cleanFinalName(finalName);
    const key = divisionKey(division);
    const closed = opennessClass(openness) === "合";
    if (!final || !key) return "";

    const candidates = RIME_TURN_ROWS.filter((row) => (row[key] as readonly string[]).includes(final));
    const exact = candidates.find((row) => closed ? row.turn.includes("合") : row.turn.includes("開"));
    return exact?.turn || candidates[0]?.turn || "";
  }

  function localizedOpenness(value: string): string {
    const normalized = value.toLowerCase();
    if (normalized === "open") return "개 開";
    if (normalized === "closed") return "합 合";
    return value;
  }

  function localizedTone(value: string): string {
    const normalized = value.toLowerCase();
    if (normalized.startsWith("level")) return "평 平";
    if (normalized.startsWith("rising")) return "상 上";
    if (normalized.startsWith("departing")) return "거 去";
    if (normalized.startsWith("checked")) return "입 入";
    return value;
  }

  function ownLabel(item: Element): string {
    let label = "";
    for (const child of item.childNodes) {
      if (child instanceof Element && /^(UL|OL|DL|TABLE)$/.test(child.tagName)) break;
      label += child.textContent ?? "";
    }
    return normalize(label)
      .replace(/\s*\(key\)$/i, "")
      .replace(/[:：+]+\s*$/, "")
      .trim();
  }

  const SKIPPED_ENTRY = /^\(?\s*(audio|homophones?|notes?|middle chinese|old chinese)\b/i;

  // The pronunciation box renders both a one-line summary per dialect and a
  // full expanded list (inside .vsHide). Readings are taken from the expanded
  // list when one exists, otherwise from the summary lines.
  function parseModernReadings(pronunciation: Element): ModernGroup[] {
    const groups: ModernGroup[] = [];
    const groupFor = (key: string): ModernGroup => {
      let group = groups.find((entry) => entry.key === key);
      if (!group) {
        group = { key, rows: [] };
        groups.push(group);
      }
      return group;
    };

    const leaves = [...pronunciation.querySelectorAll("li, dd")].filter(
      (item) => !item.querySelector("ul, ol, dl, table") && !item.closest("table"),
    );
    const hasExpanded = leaves.some((item) => item.closest(".vsHide"));

    for (const item of leaves) {
      if (hasExpanded && !item.closest(".vsHide")) continue;

      const content = normalize(item.textContent);
      const colonAt = content.indexOf(":");
      if (colonAt <= 0) continue;

      const rawSystem = normalize(content.slice(0, colonAt)).replace(/\s*\(key\)$/i, "");
      const value = normalize(content.slice(colonAt + 1));
      if (!rawSystem || !value) continue;
      if (SKIPPED_ENTRY.test(rawSystem)) continue;

      const chain: string[] = [];
      let node: Element | null = item.parentElement;
      while (node && node !== pronunciation) {
        if (node.tagName === "LI" || node.tagName === "DD") {
          const label = ownLabel(node);
          if (label) chain.unshift(label);
        }
        node = node.parentElement;
      }

      let groupKey = chain[0] ?? "";
      let system = normalize([...chain.slice(1), rawSystem].join(" "));
      if (!groupKey) {
        const grouped = rawSystem.match(/^([^(]+?)\s*\((.+)\)$/);
        if (grouped) {
          groupKey = grouped[1].trim();
          system = grouped[2].trim();
        } else {
          groupKey = rawSystem;
          system = "Reading";
        }
      }
      if (SKIPPED_ENTRY.test(groupKey)) continue;
      groupKey = groupKey.replace(/^\((.+)\)$/, "$1");

      groupFor(groupKey).rows.push({
        system,
        value,
        lang: /zhuyin|bopomofo/i.test(system) ? "zh-Bopo" : undefined,
      });
    }

    return groups;
  }

  function parseRenderedHtml(html: string) {
    const parsed = new DOMParser().parseFromString(html, "text/html");
    const chinese = sectionContainer(parsed, "Chinese");
    const pronunciation = chinese?.querySelector(".zhpron");

    const modern = pronunciation ? parseModernReadings(pronunciation) : [];

    const middleChinese: MiddleChineseReading[] = [];
    const zhengzhang: string[] = [];
    const baxterSagart: string[] = [];

    for (const table of pronunciation?.querySelectorAll<HTMLTableElement>("table") ?? []) {
      const oldChineseValues = rowValues(table, "Old Chinese").filter(Boolean);
      if (oldChineseValues.length) {
        if (rowValue(table, "Rime group")) zhengzhang.push(...oldChineseValues);
        else if (rowValues(table, "Middle Chinese").length) baxterSagart.push(...oldChineseValues);
        continue;
      }

      const baxters = rowValues(table, "Baxter").filter(Boolean);
      if (!baxters.length) continue;

      const finals = rowValues(table, "Final");
      const fanqies = rowValues(table, "Fanqie");
      const initials = rowValues(table, "Initial");
      const tones = rowValues(table, "Tone");
      const opennesses = rowValues(table, "Openness");
      const divisions = rowValues(table, "Division");
      const pick = (values: string[], index: number) => values[index] ?? values[0] ?? "";

      baxters.forEach((baxter, index) => {
        const final = pick(finals, index);
        const openness = pick(opennesses, index);
        const division = pick(divisions, index);
        middleChinese.push({
          baxter,
          fanqie: pick(fanqies, index),
          initial: pick(initials, index),
          final,
          tone: localizedTone(pick(tones, index)),
          openness: localizedOpenness(openness),
          division,
          she: sheForFinal(final),
          finalClass: finalClass(final, division, openness),
          zhuan: zhuanForReading(final, division, openness),
        });
      });
    }

    return {
      modern,
      middleChinese,
      oldChinese: {
        zhengzhang: [...new Set(zhengzhang)].join(", "),
        baxterSagart: [...new Set(baxterSagart)].join(", "),
      },
    };
  }

  async function fetchWiktionary(character: string) {
    const params = new URLSearchParams({
      action: "parse",
      page: character,
      prop: "wikitext|text",
      redirects: "1",
      format: "json",
      formatversion: "2",
      origin: "*",
    });
    const response = await fetch(`${API_URL}?${params}`);
    if (!response.ok) throw new Error(`Wiktionary returned HTTP ${response.status}.`);

    const payload = await response.json();
    if (payload.error) throw new Error(payload.error.info || "Wiktionary has no entry for this character.");
    return {
      title: payload.parse.title as string,
      wikitext: payload.parse.wikitext as string,
      html: payload.parse.text as string,
    };
  }

  async function getCharacterData(character: string): Promise<CharacterData> {
    const primary = await fetchWiktionary(character);
    const primaryWiki = parseWikitext(primary.wikitext);
    const primaryHtml = parseRenderedHtml(primary.html);
    let fallbackWiki: ReturnType<typeof parseWikitext> | null = null;
    let fallbackHtml: ReturnType<typeof parseRenderedHtml> | null = null;
    let sourceCharacter = primary.title;

    if (
      primaryWiki.relatedCharacter &&
      primaryWiki.relatedCharacter !== character &&
      (primaryHtml.modern.length === 0 || primaryHtml.middleChinese.length === 0)
    ) {
      const fallback = await fetchWiktionary(primaryWiki.relatedCharacter);
      fallbackWiki = parseWikitext(fallback.wikitext);
      fallbackHtml = parseRenderedHtml(fallback.html);
      sourceCharacter = fallback.title;
    }

    const chineseGroups = primaryHtml.modern.length ? primaryHtml.modern : fallbackHtml?.modern ?? [];

    const modern: ModernGroup[] = [
      ...chineseGroups,
      {
        key: "Japanese",
        rows: [
          { system: "On", value: primaryWiki.japaneseOn || fallbackWiki?.japaneseOn || "", lang: "ja" },
          { system: "Kun", value: primaryWiki.japaneseKun || fallbackWiki?.japaneseKun || "", lang: "ja" },
        ],
      },
      {
        key: "Korean",
        rows: [
          { system: "음", systemLang: "ko", value: primaryWiki.koreanReading || fallbackWiki?.koreanReading || "", lang: "ko" },
          { system: "훈", systemLang: "ko", value: primaryWiki.koreanEumhun || fallbackWiki?.koreanEumhun || "", lang: "ko" },
        ],
      },
    ];

    return {
      character,
      sourceCharacter,
      modern,
      middleChinese: primaryHtml.middleChinese.length
        ? primaryHtml.middleChinese
        : fallbackHtml?.middleChinese ?? [],
      oldChinese: {
        zhengzhang: primaryHtml.oldChinese.zhengzhang || fallbackHtml?.oldChinese.zhengzhang || "",
        baxterSagart: primaryHtml.oldChinese.baxterSagart || fallbackHtml?.oldChinese.baxterSagart || "",
      },
    };
  }

  function setValue(selector: string, value: string) {
    text(selector).textContent = value || EMPTY_VALUE;
    text(selector).classList.toggle("empty-value", !value);
  }

  function emptyRow(message: string, span: number): HTMLTableRowElement {
    const row = document.createElement("tr");
    const cell = document.createElement("td");
    cell.colSpan = span;
    cell.className = "empty-value";
    cell.textContent = message;
    row.append(cell);
    return row;
  }

  function groupHeadingCell(group: ModernGroup, rowCount: number): HTMLTableCellElement {
    const heading = document.createElement("th");
    heading.scope = "row";
    heading.rowSpan = rowCount;

    const label = GROUP_LABELS[group.key];
    if (label) {
      heading.lang = label.lang;
      heading.append(label.native);
      const small = document.createElement("small");
      small.lang = "en";
      small.textContent = group.key;
      heading.append(small);
    } else {
      heading.textContent = group.key;
    }
    return heading;
  }

  function renderModern(groups: ModernGroup[]) {
    if (!modernContainer) return;
    modernContainer.replaceChildren();

    if (!groups.length) {
      modernContainer.append(emptyRow("No modern readings are listed.", 3));
      return;
    }

    const orderedKeys = orderKeys(groups.map((group) => group.key), prefs.groupOrder);
    let renderedAny = false;

    for (const key of orderedKeys) {
      const group = groups.find((entry) => entry.key === key);
      if (!group || !entryVisible(`group:${group.key}`, DEFAULT_GROUPS.has(group.key))) continue;

      const visibleRows = group.rows.filter(
        (entry) => entryVisible(`row:${group.key}:${entry.system}`, defaultRowVisible(group, entry.system)),
      );
      if (!visibleRows.length) continue;
      renderedAny = true;

      visibleRows.forEach((entry, index) => {
        const row = document.createElement("tr");
        if (index === 0) row.append(groupHeadingCell(group, visibleRows.length));

        const systemCell = document.createElement("td");
        systemCell.textContent = entry.system;
        if (entry.systemLang) systemCell.lang = entry.systemLang;

        const valueCell = document.createElement("td");
        valueCell.textContent = entry.value || EMPTY_VALUE;
        if (!entry.value) valueCell.classList.add("empty-value");
        else if (entry.lang) valueCell.lang = entry.lang;
        if (entry.value && /\bIPA\b/i.test(entry.system)) valueCell.classList.add("ipa-value");

        row.append(systemCell, valueCell);
        modernContainer.append(row);
      });
    }

    if (!renderedAny) {
      modernContainer.append(emptyRow("All modern readings are hidden — re-enable them in the Display panel.", 3));
    }
  }

  function middleChineseFields(reading: MiddleChineseReading): Array<[string, string, string?]> {
    return [
      ["Baxter", reading.baxter, "baxter-reading"],
      ["Fanqie 反切", reading.fanqie, "zh"],
      ["攝", reading.she, "zh"],
      ["轉", reading.zhuan, "zh"],
      ["韻類", reading.finalClass, "zh"],
      ["Initial 聲", reading.initial, "zh"],
      ["Final 韻", reading.final, "zh"],
      ["Tone 調", reading.tone],
      ["Openness 呼", reading.openness],
      ["Division 等", reading.division],
    ];
  }

  function renderMiddleChinese(readings: MiddleChineseReading[]) {
    if (!middleChineseContainer) return;
    middleChineseContainer.replaceChildren();

    if (!readings.length) {
      middleChineseContainer.append(emptyRow("No Middle Chinese reading is listed.", 2));
      return;
    }

    const orderedLabels = orderKeys(MC_FIELD_LABELS, prefs.mcFieldOrder)
      .filter((label) => entryVisible(`mc:${label}`, true));

    if (!orderedLabels.length) {
      middleChineseContainer.append(emptyRow("All Middle Chinese fields are hidden — re-enable them in the Display panel.", 2));
      return;
    }

    readings.forEach((reading, index) => {
      if (readings.length > 1) {
        const headingRow = document.createElement("tr");
        headingRow.className = "mc-reading-heading";
        const heading = document.createElement("th");
        heading.colSpan = 2;
        heading.scope = "colgroup";
        heading.textContent = `Reading ${index + 1}`;
        headingRow.append(heading);
        middleChineseContainer.append(headingRow);
      }

      const fields = middleChineseFields(reading);
      for (const label of orderedLabels) {
        const field = fields.find(([fieldLabel]) => fieldLabel === label);
        if (!field) continue;
        const [, value, marker] = field;

        const row = document.createElement("tr");
        const heading = document.createElement("th");
        heading.scope = "row";
        heading.textContent = label;
        const cell = document.createElement("td");
        cell.textContent = value || EMPTY_VALUE;
        if (!value) cell.classList.add("empty-value");
        if (marker === "zh") cell.lang = "zh";
        if (marker === "baxter-reading") cell.classList.add("baxter-reading");
        row.append(heading, cell);
        middleChineseContainer.append(row);
      }
    });
  }

  function renderOldChinese(oldChinese: OldChinese) {
    if (!oldChineseContainer) return;
    oldChineseContainer.replaceChildren();

    let renderedAny = false;
    for (const [field, label] of OC_SYSTEMS) {
      if (!entryVisible(`oc:${field}`, true)) continue;
      renderedAny = true;

      const row = document.createElement("tr");
      const heading = document.createElement("th");
      heading.scope = "row";
      heading.textContent = label;
      const cell = document.createElement("td");
      const value = oldChinese[field];
      cell.textContent = value || EMPTY_VALUE;
      if (!value) cell.classList.add("empty-value");
      else cell.classList.add("baxter-reading");
      row.append(heading, cell);
      oldChineseContainer.append(row);
    }

    if (!renderedAny) {
      oldChineseContainer.append(emptyRow("All Old Chinese systems are hidden — re-enable them in the Display panel.", 2));
    }
  }

  function panelCheckbox(labelText: string, controlId: string, checked: boolean, onChange: (checked: boolean) => void): HTMLLabelElement {
    const label = document.createElement("label");
    label.className = "panel-toggle";
    const box = document.createElement("input");
    box.type = "checkbox";
    box.checked = checked;
    box.dataset.controlId = controlId;
    box.addEventListener("change", () => onChange(box.checked));
    const caption = document.createElement("span");
    caption.textContent = labelText;
    label.append(box, caption);
    return label;
  }

  function dragHandle(entry: HTMLElement, name: string): HTMLElement {
    const handle = document.createElement("span");
    handle.className = "drag-handle";
    handle.textContent = "⠿";
    handle.title = `Drag to reorder ${name}`;
    handle.setAttribute("aria-hidden", "true");
    handle.addEventListener("pointerdown", () => {
      entry.draggable = true;
    });
    handle.addEventListener("pointerup", () => {
      entry.draggable = false;
    });
    return handle;
  }

  function makeSortable(list: HTMLElement, save: (next: string[]) => void) {
    let dragged: HTMLElement | null = null;

    list.addEventListener("dragstart", (event) => {
      const entry = (event.target as HTMLElement).closest<HTMLElement>("[data-drag-key]");
      if (!entry || entry.parentElement !== list) return;
      dragged = entry;
      entry.classList.add("dragging");
      event.dataTransfer?.setData("text/plain", entry.dataset.dragKey ?? "");
      if (event.dataTransfer) event.dataTransfer.effectAllowed = "move";
    });

    list.addEventListener("dragover", (event) => {
      if (!dragged) return;
      event.preventDefault();
      const over = (event.target as HTMLElement).closest<HTMLElement>("[data-drag-key]");
      if (!over || over === dragged || over.parentElement !== list) return;
      const rect = over.getBoundingClientRect();
      const after = event.clientY > rect.top + rect.height / 2;
      list.insertBefore(dragged, after ? over.nextSibling : over);
    });

    list.addEventListener("drop", (event) => {
      if (dragged) event.preventDefault();
    });

    list.addEventListener("dragend", () => {
      if (!dragged) return;
      dragged.classList.remove("dragging");
      dragged.draggable = false;
      dragged = null;
      const next = Array.from(list.children)
        .map((child) => (child as HTMLElement).dataset.dragKey ?? "")
        .filter(Boolean);
      save(next);
      savePrefs();
      rerender();
    });
  }

  function panelGroupTitle(title: string): HTMLElement {
    const heading = document.createElement("h3");
    heading.className = "panel-group-title";
    heading.textContent = title;
    return heading;
  }

  function renderPanel(data: CharacterData) {
    if (!panelContainer) return;
    panelContainer.replaceChildren();

    panelContainer.append(panelGroupTitle("Sections"));
    const sectionList = document.createElement("div");
    sectionList.className = "panel-list";
    for (const [id, label] of SECTIONS) {
      sectionList.append(
        panelCheckbox(label, `section:${id}`, !prefs.hiddenSections.includes(id), (checked) => {
          prefs.hiddenSections = prefs.hiddenSections.filter((entry) => entry !== id);
          if (!checked) prefs.hiddenSections.push(id);
          savePrefs();
          applySectionVisibility();
        }),
      );
    }
    panelContainer.append(sectionList);

    panelContainer.append(panelGroupTitle("Languages"));
    const groupList = document.createElement("div");
    groupList.className = "panel-list";
    const orderedKeys = orderKeys(data.modern.map((group) => group.key), prefs.groupOrder);

    for (const key of orderedKeys) {
      const group = data.modern.find((entry) => entry.key === key);
      if (!group) continue;

      const entry = document.createElement("div");
      entry.className = "panel-entry";
      entry.dataset.dragKey = key;

      const head = document.createElement("div");
      head.className = "panel-entry-head";
      head.append(
        panelCheckbox(key, `group:${key}`, entryVisible(`group:${key}`, DEFAULT_GROUPS.has(key)), (checked) => setEntryVisible(`group:${key}`, checked)),
        dragHandle(entry, key),
      );
      entry.append(head);

      const systems = [...new Set(group.rows.map((row) => row.system))];
      if (systems.length > 1) {
        const details = document.createElement("details");
        details.className = "panel-systems";
        details.open = openPanelGroups.has(key);
        details.addEventListener("toggle", () => {
          if (details.open) openPanelGroups.add(key);
          else openPanelGroups.delete(key);
        });
        const summary = document.createElement("summary");
        summary.textContent = `${systems.length} systems`;
        details.append(summary);

        const systemList = document.createElement("div");
        systemList.className = "panel-list";
        for (const system of systems) {
          const rowKey = `row:${key}:${system}`;
          systemList.append(
            panelCheckbox(system, rowKey, entryVisible(rowKey, defaultRowVisible(group, system)), (checked) => setEntryVisible(rowKey, checked)),
          );
        }
        details.append(systemList);
        entry.append(details);
      }

      groupList.append(entry);
    }
    makeSortable(groupList, (next) => {
      prefs.groupOrder = next;
    });
    panelContainer.append(groupList);

    panelContainer.append(panelGroupTitle("Middle Chinese fields"));
    const fieldList = document.createElement("div");
    fieldList.className = "panel-list";
    const orderedFields = orderKeys(MC_FIELD_LABELS, prefs.mcFieldOrder);
    for (const label of orderedFields) {
      const entry = document.createElement("div");
      entry.className = "panel-entry-head";
      entry.dataset.dragKey = label;
      entry.append(
        panelCheckbox(label, `mc:${label}`, entryVisible(`mc:${label}`, true), (checked) => setEntryVisible(`mc:${label}`, checked)),
        dragHandle(entry, label),
      );
      fieldList.append(entry);
    }
    makeSortable(fieldList, (next) => {
      prefs.mcFieldOrder = next;
    });
    panelContainer.append(fieldList);

    panelContainer.append(panelGroupTitle("Old Chinese systems"));
    const ocList = document.createElement("div");
    ocList.className = "panel-list";
    for (const [field, label] of OC_SYSTEMS) {
      ocList.append(
        panelCheckbox(label, `oc:${field}`, entryVisible(`oc:${field}`, true), (checked) => setEntryVisible(`oc:${field}`, checked)),
      );
    }
    panelContainer.append(ocList);
  }

  function render(data: CharacterData) {
    lastData = data;
    setValue("#result-character", data.character);
    renderModern(data.modern);
    renderMiddleChinese(data.middleChinese);
    renderOldChinese(data.oldChinese);
    renderPanel(data);
    applySectionVisibility();

    const link = document.querySelector<HTMLAnchorElement>("#wiktionary-link");
    if (link) link.href = `https://en.wiktionary.org/wiki/${encodeURIComponent(data.sourceCharacter)}`;
    if (results) results.hidden = false;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const character = singleHanCharacter(input?.value ?? "");

    if (!character) {
      if (status) status.textContent = "Please enter exactly one Han character.";
      if (results) results.hidden = true;
      input?.focus();
      return;
    }

    if (status) status.textContent = `Fetching ${character} from Wiktionary…`;
    if (results) results.hidden = true;
    form?.classList.add("is-loading");

    try {
      const data = await getCharacterData(character);
      render(data);
      if (status) status.textContent = data.sourceCharacter !== character
        ? `Showing ${character}; missing historical data was supplemented from ${data.sourceCharacter}.`
        : `Readings for ${character}.`;
      const url = new URL(window.location.href);
      url.searchParams.set("q", character);
      history.replaceState(null, "", url);
    } catch (error) {
      if (status) status.textContent = error instanceof Error
        ? error.message
        : "The Wiktionary lookup failed.";
    } finally {
      form?.classList.remove("is-loading");
    }
  });

  const initialCharacter = singleHanCharacter(new URLSearchParams(window.location.search).get("q") ?? "");
  if (initialCharacter && input && form) {
    input.value = initialCharacter;
    form.requestSubmit();
  }
</script>

