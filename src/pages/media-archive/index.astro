---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatMediaTitle, getMediaItems, groupMediaByMonth } from "@/lib/media";

const groupedMedia = groupMediaByMonth(await getMediaItems());
---
<BaseLayout title="Media Archive">
  <h1>Media Archive</h1>

  {[...groupedMedia.entries()].map(([month, items]) => (
    <div class="media-month">
      <h2 class="media-month-header">{month}</h2>
      <div class="album-flex inside-text-width">
        {items.map((item) => (
          <div class="album">
            {item.url ? (
              <a href={item.url} class="album-link"><img src={item.photo} alt={formatMediaTitle(item)} /></a>
            ) : (
              <img src={item.photo} alt={formatMediaTitle(item)} />
            )}
            <div class="album-info">
              <h4>{formatMediaTitle(item)} – {item.creator}{item.featured && <span class="featured-star">★<span class="featured-label">Featured!</span></span>}</h4>
              {item.review && <p><em>{item.review}</em></p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}

  <p class="backarrow" style="text-align: right;">
    <a href="/">← Back to home</a>
  </p>
</BaseLayout>
