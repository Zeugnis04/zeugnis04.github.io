---
import BaseLayout from "@/layouts/BaseLayout.astro";

const mediaItems = [
  { title: "데이미언 허스트 展", creator: "국립현대미술관 MMCA", photo: "/assets/img/media-archive/damien-hurst.png", date: "2026-04-18" },
  { title: "Wisdom Through Music", creator: "Pharoah Sanders", photo: "https://i.scdn.co/image/ab67616d000082c1d24eb39e1db31157ac27236b", date: "2026-04-15" },
  { title: "星沙たち、", creator: "青葉市子", photo: "/assets/img/media-archive/hosi.webp", date: "2026-04-09", review: "to live with music" },
  { title: "Places and Spaces", creator: "Donald Byrd", photo: "/assets/img/media-archive/places-and-spaces.webp", date: "2026-04-04" },
  { title: "Heavy Weather", creator: "Weather Report", photo: "/assets/img/media-archive/heavyweather.webp", date: "2026-04-03" },
  { title: "15th Anniversary Concert", creator: "青葉市子", photo: "https://i.scdn.co/image/ab67616d000082c15c3f9b600d47631d78f110d4", date: "2026-03-01" },
  { title: "Project Hail Mary", creator: "Phil Lord and Christopher Miller", photo: "/assets/img/media-archive/projecthailmary.webp", date: "2026-03", featured: false },
  { title: "ジョジョの奇妙な冒険 黄金の旋風", creator: "david production", photo: "/assets/img/media-archive/jojo5.webp", date: "2026-03", featured: false, review: "Arrivederci!" },
  { title: "어쩔수가없다", creator: "박찬욱", photo: "/assets/img/media-archive/eccelswukaepsta.webp", date: "2026-02-18", featured: false },
  { title: "Ege Bamyasi", creator: "CAN", photo: "https://i.scdn.co/image/ab67616d000082c11e752abb6aa64d896b2c7751", date: "2026-02-25" },
  { title: "雪国", creator: "川端康成", photo: "/assets/img/currently-reading-books/yukiguni.jpeg", date: "2026-01", featured: false },
  { title: "三四郎", creator: "夏目漱石", photo: "/assets/img/currently-reading-books/sansirou.jpg", date: "2025-09", featured: false },
  { title: "Magic, Alive!", creator: "McKinley Dixon", photo: "/assets/img/magic-alive/magic-alive.webp", date: "2025-09-13", featured: true, url: "/blog/magic-alive/", review: "how much more alive can music be" },
  { title: "Songs of a Lost World", creator: "The Cure", photo: "/assets/img/songs-of-a-lost-world/songs-of-a-lost-world.webp", date: "2025-09-13", featured: true, url: "/blog/songs-of-a-lost-world/", review: "emotional and powerful yet unique" },
  { title: "Luminescent Creatures", creator: "青葉市子", photo: "/assets/img/luminescent-creatures/luminiscentcreatures.png", date: "2025-04-27", featured: true, url: "/blog/luminescent-creatures/", review: "a deep dive into Mother Earth" },
  { title: "Forever Howlong", creator: "Black Country, New Road", photo: "/assets/img/forever-howlong/foreverhowlong.png", date: "2025-05-08", featured: true, url: "/blog/forever-howlong/", review: "communal and baroque" },
];

const sortedMedia = mediaItems.sort((a, b) => b.date.localeCompare(a.date));
const groupedMedia = new Map<string, typeof sortedMedia>();

for (const item of sortedMedia) {
  const month = item.date.slice(0, 7);
  groupedMedia.set(month, [...(groupedMedia.get(month) ?? []), item]);
}
---
<BaseLayout title="Media Archive">
  <h1>Media Archive</h1>

  {[...groupedMedia.entries()].map(([month, items]) => (
    <div class="media-month">
      <h2 class="media-month-header">{month}</h2>
      <div class="album-flex inside-text-width">
        {items.map((item) => (
          <div class="album">
            {item.url ? (
              <a href={item.url} class="album-link"><img src={item.photo} alt={item.title} /></a>
            ) : (
              <img src={item.photo} alt={item.title} />
            )}
            <div class="album-info">
              <h4>{item.title}{item.featured && <span class="featured-star">★<span class="featured-label">Featured!</span></span>}</h4>
              {item.review && <p><em>{item.review}</em></p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}

  <p class="backarrow" style="text-align: right;">
    <a href="/">← Back to home</a>
  </p>
</BaseLayout>
