---
import BaseLayout from "@/layouts/BaseLayout.astro";
// import Comments from "@/components/Comments.astro";

type Props = {
  frontmatter: {
    title: string;
    subtitle?: string;
    description?: string;
    date: Date | string;
    tags?: string[];
    comments?: boolean;
    full_width?: boolean;
    korean?: boolean;
  };
};

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date);
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const tags = frontmatter.tags ?? [];
// const showComments = frontmatter.comments !== false;
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  fullWidth={frontmatter.full_width}
  korean={frontmatter.korean}
>
  <h1>{frontmatter.title}</h1>
  {frontmatter.subtitle && <p class="subtitle">{frontmatter.subtitle}</p>}
  <p class="byline">Zeugnis — {formattedDate}</p>

  <slot />

  {tags.length > 0 && (
    <div class="meta-tags">
      <p class="post-tags">
        <strong><span class="tag-ornament">j</span> Tags : </strong>
        {tags.map((tag, index) => (
          <>
            <a href={`/tags/#${tag}`} class="post-tag">{tag}</a>{index < tags.length - 1 ? ", " : ""}
          </>
        ))}
      </p>
    </div>
  )}

  <section>
    <div style="clear: both"></div>
    <p class="backarrow"><a href="/blog/blog-list/">← Back to all posts</a></p>
  </section>

  <!-- {showComments && <Comments />} -->
</BaseLayout>
