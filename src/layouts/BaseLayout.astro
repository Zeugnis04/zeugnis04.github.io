---
import "@/styles/site.scss";
import { ViewTransitions } from "astro:transitions";

type Props = {
  title?: string;
  description?: string;
  subtitle?: string;
  headTitle?: string;
  hero?: boolean;
  fullWidth?: boolean;
  korean?: boolean;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
};

const {
  title = "Random Access Memories",
  description = "Blogspace for anything",
  subtitle,
  headTitle,
  hero = false,
  fullWidth = false,
  korean = false,
  noindex = false,
  image,
  imageAlt,
  ogType = "website",
} = Astro.props;

const pageTitle = headTitle ?? (title === "Random Access Memories"
  ? title
  : `${title} | Random Access Memories`);
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Scrapers only accept absolute URLs, so site-relative covers like
// `/assets/img/foo.webp` have to be resolved against the site origin.
const socialImageURL = new URL(
  image ?? "/favicons/android-icon-512x512.png",
  Astro.site ?? Astro.url,
).href;
const activeSection = currentPath.startsWith("/blog/")
  ? "blog"
  : currentPath.startsWith("/tags/")
    ? "tags"
    : currentPath.startsWith("/zeugnis/")
      ? "zeugnis"
      : currentPath.startsWith("/misc/")
        ? "misc"
        : "home";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <ViewTransitions />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Random Access Memories" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={imageAlt ?? pageTitle} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt ?? pageTitle} />
    <!-- The kit's JS and the font files it pulls come from two different
         origins; opening both connections early shaves a round trip off the
         race against `scriptTimeout` below. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <script is:inline>
      (function(d) {
        var config = {
          kitId: "baf3roc",
          // When this fires, Typekit.load() never runs and no @font-face is
          // injected — so every CJK run on the page silently falls back to a
          // system serif. The timeout exists only to stop `wf-loading` from
          // hiding text forever, and nothing in our CSS uses the wf-* classes,
          // so it can afford to be generous: a slow connection loading a large
          // CJK kit should still get the right typeface.
          scriptTimeout: 10000,
          async: true,
        };
        var h = d.documentElement;
        var t = setTimeout(function() {
          h.className = h.className.replace(/\bwf-loading\b/g, "") + " wf-inactive";
        }, config.scriptTimeout);
        var tk = d.createElement("script");
        var f = false;
        var s = d.getElementsByTagName("script")[0];
        h.className += " wf-loading";
        tk.src = "https://use.typekit.net/" + config.kitId + ".js";
        tk.async = true;
        tk.onload = tk.onreadystatechange = function() {
          var a = this.readyState;
          if (f || (a && a != "complete" && a != "loaded")) return;
          f = true;
          clearTimeout(t);
          try {
            Typekit.load(config);
          } catch (e) {}
        };
        s.parentNode.insertBefore(tk, s);
      })(document);
    </script>
<link rel="icon" href="/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-icon-180x180.png" />
    <link rel="manifest" href="/favicons/manifest.json" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class:list={[fullWidth && "full-width", korean && "korean-font-post"]}>
    <header>
      <nav class="group" aria-label="Primary">
        <ul>
          <li><a class:list={[activeSection === "home" && "active"]} href="/">Home</a></li>
          <li><a class:list={[activeSection === "blog" && "active"]} href="/blog/blog-list/">Blog</a></li>
          <li><a class:list={[activeSection === "tags" && "active"]} href="/tags/">Tags</a></li>
          <li><a class:list={[activeSection === "zeugnis" && "active"]} href="/zeugnis/">Zeugnis</a></li>
          <li><a class:list={["ornament-tab", activeSection === "misc" && "active"]} href="/misc/" aria-label="Sundries" title="Sundries"><span class="nav-ornament">j</span></a></li>
        </ul>
      </nav>
    </header>
    <article class="group">
      {hero && title && <h1 class="header-title">{title}</h1>}
      {hero && subtitle && <h2 class="header-subtitle">{subtitle}</h2>}
      {hero && subtitle && <p class="margin-maker"></p>}
      <slot />
    </article>
  </body>
</html>
