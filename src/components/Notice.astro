---
const { title } = Astro.props;
---
<div class="notice">
  {title && <span class="notice-title">{title}</span>}
  <slot />
</div>

<style>
  .notice {
    border-top: 2px solid black;
    border-bottom: 2px solid black;
    padding: 0.75rem 0;
    margin: 1.5rem 0;
    line-height: 1.5;
    font-size:1.4rem;
    width: 55%;
  }

  .notice-title {
    display: block;
    font-feature-settings: "smcp";
    font-size: 1.8rem;
    color: #ca4a4a;
    margin-bottom: 0.25rem;
  }
</style>
